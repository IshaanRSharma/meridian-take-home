# Inlined at BUILD time by Vite. Getting this wrong is the usual first-deploy failure.
# Left empty in dev: vite.config.ts proxies /api to 127.0.0.1:8000, same-origin.
VITE_API_URL=

# Supabase Auth gates the UI. The API is single-tenant and unauthenticated
# (Claude.md §4), so this is a front-door lock, not row-level security.
VITE_SUPABASE_URL=https://pfescjqgwpfnkjjgnucw.supabase.co
VITE_SUPABASE_ANON_KEY=
