# Frontend only. Copy to ui/.env — never committed.
#
# Vite inlines these into the bundle at BUILD time, which has two consequences.
# On Railway they are build args, not runtime variables — getting that wrong
# produces a UI that builds cleanly and then calls localhost in production. And
# anything here is public by definition, so only keys meant to be public belong.

# The api service's public URL. Build arg on Railway.
VITE_API_URL=http://localhost:8000

# The browser's only direct database access: one subscription to `events`,
# guarded by a read-only policy. Every other read and write goes through the API.
VITE_SUPABASE_URL=https://pfescjqgwpfnkjjgnucw.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_QD1BjZDBBfvRz8D7BYIm7g_Cy2WrWp7
