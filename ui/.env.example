# Inlined at BUILD time by Vite. Getting this wrong is the usual first-deploy
# failure. Left empty in dev: vite.config.ts proxies /api to 127.0.0.1:8000,
# so the browser talks to the API same-origin and there is no CORS preflight.
VITE_API_URL=

# Supabase Auth gates the UI. The API is single-tenant and talks to Postgres
# directly over DATABASE_URL, so this is a front door and not row-level
# security — and it is the ONLY Supabase credential anything here needs.
VITE_SUPABASE_URL=https://pfescjqgwpfnkjjgnucw.supabase.co

# Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# Browser-safe by design: it identifies the project, carries the `anon` role,
# and every table is guarded by RLS.
#
# NEVER put the secret key (sb_secret_...) here. Vite inlines this value into a
# static asset, and the secret key bypasses RLS. The app refuses to start if it
# finds one.
VITE_SUPABASE_PUBLISHABLE_KEY=
