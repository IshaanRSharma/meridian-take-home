# ── python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ── node ─────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── secrets and local state ──────────────────────────────────────────────
.env
.env.local
*.pem

# Meridian's own material is theirs, not ours to redistribute — and our design
# notes stay local until the writeup decides what belongs in a public repo.
docs/

# ── local service data (docker-compose volumes) ──────────────────────────
.data/

# ── editors and os ───────────────────────────────────────────────────────
.DS_Store
.idea/
*.swp

# Generated agents are committed once there is one worth reviewing. Held back
# until the build it belongs to is registered.
agents/

# Agent worktrees — transient, never committed.
.claude/worktrees/

/handoffs

# Sweep output. The .gitkeep stays; the rows do not.
eval/runs/*.csv
# Toy agents for falsifying the skeleton contract. Scratch, never shipped.
test_toy_agents/
