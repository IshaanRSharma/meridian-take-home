# Backend only. Copy to meridian/.env — never committed.
#
# Nothing here is shared with the frontend. The browser has its own ui/.env and
# the two overlap in nothing, because the backend talks to Postgres directly and
# never touches Supabase's REST API.

# ── database ─────────────────────────────────────────────────────────────
# Supabase → Connect → Session pooler (port 5432). Not the "Direct connection"
# host, which resolves IPv6-only on newer projects and fails on IPv4 networks.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── llm ──────────────────────────────────────────────────────────────────
# One provider for extraction, review and codegen. Temperature is pinned to 0
# in code, so a failing eval case fails for a logic reason.
OPENAI_API_KEY=
OPENAI_MODEL=

# ── composio (gmail) ─────────────────────────────────────────────────────
# One connection per customer mailbox. The entity id is the indirection that
# makes the same spec deploy to a second customer without changing.
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=

# ── temporal ─────────────────────────────────────────────────────────────
# `make temporal` locally; Temporal Cloud in production. Code is identical —
# only the address and namespace change.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meridian
