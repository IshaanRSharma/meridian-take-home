# Copy to .env and fill in. Never commit .env.
#
# Every LLM call in the system — extraction, semantic review, codegen — goes
# through OpenAI. One key, one SDK, one auth path.

# ── LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Structured generation (extraction, reviewer, codegen planning).
OPENAI_MODEL=
# Temperature is pinned to 0 in code for reproducibility; see Claude.md §23.

# ── Supabase (Postgres 15) ───────────────────────────────────────────────
# FastAPI holds the service role key and does ALL reads and writes.
# The browser only ever uses the anon key, and only to subscribe to `events`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# asyncpg connection string. Points at Supabase in dev/prod, at the local
# docker-compose Postgres when running integration tests.
DATABASE_URL=postgresql://meridian:meridian@localhost:54329/meridian

# ── Temporal ─────────────────────────────────────────────────────────────
# `make temporal` starts a dev server at this address.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meridian

# ── Composio (Gmail) ─────────────────────────────────────────────────────
# Not wired until unit 11. Until then the harness runs on FixtureGmailTool
# and no network call is made. See Claude.md §17.
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=
