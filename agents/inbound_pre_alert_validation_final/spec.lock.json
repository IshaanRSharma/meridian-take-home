    "does_every_batch_have_a_matching_certificate": {
      "capabilities": [],
      "config": {
        "criteria": [
          {
            "left": {
              "entity": "commercial_invoice",
              "path": "line_items[].batch_no"
            },
            "op": "each_has_matching",
            "reads": [],
            "right": {
              "field": {
                "entity": "certificate_of_analysis",
                "path": "batch_no"
              },
              "kind": "field"
            }
          }
        ],
        "evidence": [
          {
            "entity": "commercial_invoice",
            "path": "invoice_no"
          },
          {
            "entity": "commercial_invoice",
            "path": "line_items[].batch_no"
          }
        ],
        "fills": [
          {
            "field": {
              "entity": "shipment_summary",
              "path": "coa_total"
            },
            "measure": "checked"
          },
          {
            "field": {
              "entity": "shipment_summary",
              "path": "coa_success"
            },
            "measure": "passed"
          },
          {
            "field": {
              "entity": "shipment_summary",
              "path": "failed_coa"
            },
            "measure": "failed"
          }
        ],
        "inputs": [
          "commercial_invoice",
          "certificate_of_analysis"
        ],
        "instructions": "For every batch number listed across the commercial invoices, check there is a certificate of analysis with that batch number. Report how many batches we expected, how many had a certificate, and how many did not.",
        "name": "Does every batch have a matching certificate?",
        "on_missing_input": "fail",
        "outcomes": [
          {
            "name": "pass",
            "priority": 0
          },
          {
            "name": "missing_coa",
            "priority": 1
          }
        ],
        "quantifier": "all",
        "scope": "per_line_item"
      },
      "context": {
        "inherited": [],
        "local": [
          "[rule] A batch number on the invoice and the certificate counts as the same batch when the only difference is a trailing lot suffix letter that is omitted on the certificate."
        ],
        "negative": [
          "A batch whose certificate says something different is not handled as a separate discrepancy; it follows the same missing-certificate failure path and is reported the same way because the paperwork for that batch is not right.",
          "No other differences are ignored; if the letters, digits, order, or case differ in any other way, it is a different batch and must be reported.",
          "The process must not count a batch twice just because its certificate arrived more than once; the count is of batches listed on the invoice, not of certificates received."
        ],
        "provenance": [
          "39e76d72-c65b-4c9f-b463-0222316b0b8f",
          "61422786-a65b-4038-8767-6a363efb1058",
          "86154e3c-5a1a-435d-9e42-b04dbcdf9210"
        ]
      },
      "key": "does_every_batch_have_a_matching_certificate",
      "primitive_type": "check"
    },
